# ===========================================
# AquaTrack - Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aquatrack

# JWT
JWT_SECRET=your-secret-jwt-key-here

# Firebase (mobile app uses these via EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# API Server
PORT=3000
NODE_ENV=development

# ESP32 Device Auth
DEVICE_API_KEY=your-device-api-key

# Payment Gateway (configurable)
PAYMENT_GATEWAY_URL=https://sandbox.payhere.lk
PAYMENT_SECRET=your-payment-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Mobile App API URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api
